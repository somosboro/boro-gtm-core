# Copy to /opt/boro_gtm/.env with mode 600. Never commit the real file.
GTM_ENV=production
GTM_LOG_LEVEL=INFO
GTM_DB_PASSWORD=change-me-long-random
# Bearer token for /api/v1/engine/*. Without it the engine API answers 503.
GTM_ENGINE_API_TOKEN=change-me-long-random
# Stays true until `gtm engine cutover-report` passes and the ChatGPT
# commercial automations are switched off.
GTM_ENGINE_SHADOW_MODE=true
GTM_ENGINE_SOURCING_ENABLED=true
GTM_ENGINE_WORKER_NAME=vps-worker-1
# Optional reply-label suggestions. Rules decide everything without it.
GTM_ENGINE_LLM=none
