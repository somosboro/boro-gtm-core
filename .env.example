# ---------------------------------------------------------------------------
# BoRo GTM Core — Working Codename
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Application
GTM_APP_NAME=BoRo GTM Core
GTM_ENV=local
GTM_LOG_LEVEL=INFO
GTM_LOG_JSON=true

# Database (docker compose default)
GTM_DATABASE_URL=postgresql+psycopg://gtm:gtm@localhost:5432/gtm_core

# Test database used by the integration suite
GTM_TEST_DATABASE_URL=postgresql+psycopg://gtm:gtm@localhost:5432/gtm_core_test

# Scoring engine
# Minimum coverage required before contextual results are treated as
# rank-comparable. Callers may override per-request with allow_low_coverage.
GTM_MIN_CONTEXTUAL_COVERAGE=0.5

# Reference-reproduction tolerance (absolute score delta)
GTM_SCORE_TOLERANCE=0.005

# Optional: Redis for the job abstraction (not required for M0/M1)
# GTM_REDIS_URL=redis://localhost:6379/0
